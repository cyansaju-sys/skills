{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "spanish",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(pacman *)",
      "Bash(yay *)",
      "Bash(apt *)",
      "Bash(brew install *)",
      "Bash(git config --global *)",
      "Bash(npm config set *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)"
    ]
  }
}